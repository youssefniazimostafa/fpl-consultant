# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Fetched FPL data (regenerate with `uv run python -m fpl.fetch`)
data/raw/*
data/tables/*
!data/raw/.gitkeep
!data/tables/.gitkeep

# Cloned historical reference repos (regenerate with `uv run python -m fpl.historical`)
data/external/*
!data/external/.gitkeep
